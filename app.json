{
  "expo": {
    "name": "SecureChat",
    "slug": "securechat-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0c1317"
    },
    "android": {
      "package": "com.securechat.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0c1317"
      },
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE"
      ]
    }
  }
}

